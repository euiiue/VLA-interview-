# App environment
PROJECT_NAME=docs-to-quiz
ENVIRONMENT=local

# Comma-separated origins allowed to call the API from a browser (frontend dev server, etc.)
CORS_ALLOW_ORIGINS=http://localhost:3000

# Retrieval config
# RETRIEVAL_MODE: bm25_only | hybrid_rerank
RETRIEVAL_MODE=bm25_only
BM25_CANDIDATES_TOP_N=200
RERANK_TOP_N=50
EVIDENCE_TOP_K=10
EVIDENCE_TOP_K_EXPANDED=20
FUSION_ENABLED=false
RRF_K=60

# Knowledge base ingestion (domain-agnostic, local-only)
KNOWLEDGE_DIR=data/knowledge
EMBED_MODEL=intfloat/multilingual-e5-small
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# LLM provider: gemini_sdk | openai_compatible | groq | cerebras | ollama
LLM_PROVIDER=gemini_sdk
LLM_TIMEOUT_SEC=60
LLM_TEMPERATURE=0.2
LLM_TOP_P=1.0
LLM_MAX_COMPLETION_TOKENS=2048
LLM_FALLBACKS=
LLM_JSON_MODE=true
LLM_MAX_ATTEMPTS=4
LLM_CANDIDATES=1
LLM_DEDUP_ATTEMPTS=2
LLM_REASONING_EFFORT=
LLM_STOP=
LLM_STREAM=false
OK_ONLY_MODE=true
OK_ONLY_MAX_ROUNDS=3
OK_ONLY_MAX_SECONDS=90
EVIDENCE_FIRST=true
EVIDENCE_FIRST_MAX_SENTENCES=2
EVIDENCE_FIRST_MAX_CHARS=600
EVIDENCE_MAX_CHARS_PER_DOC=800
EVIDENCE_MAX_TOTAL_CHARS=4000
QUESTION_BANK_PATH=app/logging/question_bank.jsonl
QUESTION_BANK_FALLBACK=false
QUESTION_BANK_WRITE_OK=false
QUESTION_BANK_ALLOW_ANY_TOPIC=false

# Gemini config (google-genai)
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-2.5-flash-lite

# OpenAI-compatible config (e.g., OpenAI, Groq via OpenAI compat)
# LLM_PROVIDER=openai_compatible
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Groq Cloud (SDK)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# Cerebras Cloud (SDK)
# LLM_PROVIDER=cerebras
# CEREBRAS_API_KEY=your_cerebras_api_key_here
# LLM_MODEL=llama-3.3-70b
CEREBRAS_TIMEOUT_SEC=30
CEREBRAS_MAX_RETRIES=1

# Ollama (local)
# LLM_PROVIDER=ollama
# LLM_API_BASE=http://localhost:11434
# LLM_MODEL=qwen3:8b

# Reviewer (single, legacy path — defaults to LLM_* when empty).
# Ignored once Cross-CoVe (below) is enabled with all 3 reviewers configured.
REVIEWER_ENABLED=true
REVIEWER_PROVIDER=
REVIEWER_API_KEY=
REVIEWER_API_BASE=
REVIEWER_MODEL=
REVIEWER_TIMEOUT_SEC=60
REVIEWER_FALLBACKS=
REVIEWER_MAX_COMPLETION_TOKENS=256

# Cross-CoVe: verify each answer with 3 independently configured reviewer
# LLMs and take a majority vote. Falls back to the single REVIEWER_* above
# for any reviewer left unconfigured. Worked example below mixes providers
# so the 3 votes aren't correlated by one provider's blind spots.
COVE_ENABLED=true
COVE_VOTE_COUNT=3

# Reviewer 1 (example: Groq)
# REVIEWER_1_PROVIDER=groq
# REVIEWER_1_API_KEY=your_groq_api_key_here
# REVIEWER_1_MODEL=llama-3.3-70b-versatile
REVIEWER_1_PROVIDER=
REVIEWER_1_API_KEY=
REVIEWER_1_API_BASE=
REVIEWER_1_MODEL=
REVIEWER_1_FALLBACKS=

# Reviewer 2 (example: Gemini)
# REVIEWER_2_PROVIDER=gemini_sdk
# REVIEWER_2_API_KEY=your_gemini_api_key_here
# REVIEWER_2_MODEL=gemini-2.5-flash-lite
REVIEWER_2_PROVIDER=
REVIEWER_2_API_KEY=
REVIEWER_2_API_BASE=
REVIEWER_2_MODEL=
REVIEWER_2_FALLBACKS=

# Reviewer 3 (example: Cerebras)
# REVIEWER_3_PROVIDER=cerebras
# REVIEWER_3_API_KEY=your_cerebras_api_key_here
# REVIEWER_3_MODEL=llama-3.3-70b
REVIEWER_3_PROVIDER=
REVIEWER_3_API_KEY=
REVIEWER_3_API_BASE=
REVIEWER_3_MODEL=
REVIEWER_3_FALLBACKS=

# NLI evaluation (entailment) — used by /eval/nli and quality scripts
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli

# Semantic evaluation (embedding similarity) — used by /eval/semantic
SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
