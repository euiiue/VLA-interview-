# Existing local PyTorch images may be reused via --build-arg BASE_IMAGE=...
ARG BASE_IMAGE=python:3.11-slim
FROM ${BASE_IMAGE}
USER root
RUN python -c "import torch; assert torch.__version__.startswith('2.6')" || python -m pip install --no-cache-dir torch==2.6.0 --index-url https://download.pytorch.org/whl/cpu
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1
USER 65534:65534
WORKDIR /tmp
ENTRYPOINT ["python"]
